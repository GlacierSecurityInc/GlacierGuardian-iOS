{
    "api": {
        "plugins": {
            "awsAPIPlugin": {
                "GlacierAppSyncAPI": {
                    "endpointType": "GraphQL",
                    "endpoint": "https://aaaaaaaaaaaa.appsync-api.us-east-1.amazonaws.com/graphql",
                    "region": "us-east-1",
                    "authorizationType": "AMAZON_COGNITO_USER_POOLS"
                }
            }
        }
    },
    "auth": {
        "plugins": {
            "awsCognitoAuthPlugin": {
                "IdentityManager": {
                    "Default": {}
                },
                "CredentialsProvider": {
                    "CognitoIdentity": {
                        "Default": {
                            "PoolId": "us-east-1:aaaaaaaaaaaa",
                            "Region": "us-east-1"
                        }
                    }
                },
                "CognitoUserPool": {
                    "Default": {
                        "PoolId": "us-east-1_aaaaaaaaa",
                        "AppClientId": "aaaaaaaaaaaa",
                        "AppClientSecret": "aaaaaaaaaaaa",
                        "Region": "us-east-1"
                    }
                },
                "Auth": {
                    "Default": {
                        "authenticationFlowType": "USER_SRP_AUTH",
                        "OAuth": {
                            "WebDomain": "https://aaaaaaaaaaaa.auth.us-east-1.amazoncognito.com",
                            "AppClientId": "aaaaaaaaaaaa",
                            "SignInRedirectURI": "glaciermessenger://",
                            "SignOutRedirectURI": "glaciermessenger://",
                            "Scopes": [
                                "email",
                                "openid",
                                "aws.cognito.signin.user.admin"
                            ]
                        },
                        "mfaConfiguration": "OFF",
                        "mfaTypes": [
                            "SMS"
                        ],
                        "passwordProtectionSettings": {
                            "passwordPolicyMinLength": 12,
                            "passwordPolicyCharacters": []
                        }
                    }
                }
            }
        }
    },
    "storage": {
        "plugins": {
            "awsS3StoragePlugin": {
                "bucket": "aaaaaaaaaaaa",
                "region": "us-east-1"
            }
        }
    }
}
